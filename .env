# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=OPEN_AI_KEY_HERE
# Provider: openai (default) or anthropic
BOOK_PROVIDER=openai
# Model for the chosen provider (e.g. gpt-4o, gpt-4.1, gpt-5 / claude-sonnet-4-5)
BOOK_MODEL=gpt-4o
# Max output tokens per call. Chapters are written section by section, so 8000 is plenty.
BOOK_MAX_TOKENS=8000
# Network resilience: request timeout (seconds) and SDK retries on rate limits/5xx
BOOK_TIMEOUT=300
BOOK_MAX_RETRIES=4
# Optional cost estimate in usage.json (USD per 1M tokens for your model)
# BOOK_PRICE_INPUT_PER_1M=2.50
# BOOK_PRICE_OUTPUT_PER_1M=10.00
# Only needed if BOOK_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-key-here
# Set to 1 to run fully offline with a deterministic mock LLM (no key needed)
BOOK_MOCK=0
